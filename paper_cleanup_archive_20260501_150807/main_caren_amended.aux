\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Cross-domain detection on FakeAVCeleb (AV1M $\to $ FAVC, $N=6{,}667$). Each numeric cell reports AUC/AP; all rows report the mean over three independent seeds. AVH-Align/sup is the single published AV1M-trained checkpoint from \citet  {smeu2025avhalign}. RV-FA\nobreakspace  {}=\nobreakspace  {}RealVideo-FakeAudio; FV-RA\nobreakspace  {}=\nobreakspace  {}FakeVideo-RealAudio; FV-FA\nobreakspace  {}=\nobreakspace  {}FakeVideo-FakeAudio. The latest \textsc  {TriRoute}\ row uses AV1M speaker-group nuisance labels only; no FakeAVCeleb data enters training, validation, or model selection.}}{8}{table.1}\protected@file@percent }
\newlabel{tab:main}{{1}{8}{Cross-domain detection on FakeAVCeleb (AV1M $\to $ FAVC, $N=6{,}667$). Each numeric cell reports AUC/AP; all rows report the mean over three independent seeds. AVH-Align/sup is the single published AV1M-trained checkpoint from \citet {smeu2025avhalign}. RV-FA~=~RealVideo-FakeAudio; FV-RA~=~FakeVideo-RealAudio; FV-FA~=~FakeVideo-FakeAudio. The latest \method \ row uses AV1M speaker-group nuisance labels only; no FakeAVCeleb data enters training, validation, or model selection}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cross-domain FV-RA AUC on FakeAVCeleb (AV1M $\to $ FAVC, $N{=}3{,}158$ FV-RA clips), mean over three independent seeds with error bars (one standard deviation). Dashed line marks chance ($0.5$). Bars left to right: AVH-Align/sup\nobreakspace  {}\citep  {smeu2025avhalign}, our two-way baseline, two global domain-adaptation controls (DANN/GRL $\alpha {=}1$, CORAL), three-way factorization without domain push-pull, and \textsc  {TriRoute}. Companion view of the FV-RA column in Table\nobreakspace  {}\ref {tab:main}: every two-way variant sits at or below chance, while \textsc  {TriRoute}\ is the only model that separates cleanly above $0.8$. The error bars are tight relative to this gap, indicating the $+0.4$ AUC improvement on the visual-routing diagnostic is not seed-driven.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:main_table_bar}{{2}{8}{Cross-domain FV-RA AUC on FakeAVCeleb (AV1M $\to $ FAVC, $N{=}3{,}158$ FV-RA clips), mean over three independent seeds with error bars (one standard deviation). Dashed line marks chance ($0.5$). Bars left to right: AVH-Align/sup~\citep {smeu2025avhalign}, our two-way baseline, two global domain-adaptation controls (DANN/GRL $\alpha {=}1$, CORAL), three-way factorization without domain push-pull, and \method . Companion view of the FV-RA column in Table~\ref {tab:main}: every two-way variant sits at or below chance, while \method \ is the only model that separates cleanly above $0.8$. The error bars are tight relative to this gap, indicating the $+0.4$ AUC improvement on the visual-routing diagnostic is not seed-driven}{figure.2}{}}
