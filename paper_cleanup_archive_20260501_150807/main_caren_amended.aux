\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Full leading-silence trim AUCs on FakeAVCeleb categories, mean over three independent seeds. ``Untrimmed'' is the reference condition reported in the main results; ``Trimmed'' removes raw-waveform leading silence prior to AV-HuBERT feature extraction. $\Delta = \mathrm  {Trimmed} - \mathrm  {Untrimmed}$. FV-RA is highlighted; it is the visual-routing diagnostic and stays flat across all three models, while RV-FA and FV-FA (audio-fake categories) drop substantially.}}{17}{table.11}\protected@file@percent }
\newlabel{tab:silence_control_full}{{11}{17}{Full leading-silence trim AUCs on FakeAVCeleb categories, mean over three independent seeds. ``Untrimmed'' is the reference condition reported in the main results; ``Trimmed'' removes raw-waveform leading silence prior to AV-HuBERT feature extraction. $\Delta = \mathrm {Trimmed} - \mathrm {Untrimmed}$. FV-RA is highlighted; it is the visual-routing diagnostic and stays flat across all three models, while RV-FA and FV-FA (audio-fake categories) drop substantially}{table.11}{}}
\@writefile{toc}{\contentsline {section}{\numberline {B}Additional Qualitative Routing Examples}{17}{appendix.B}\protected@file@percent }
\newlabel{app:qualitative}{{B}{17}{Additional Qualitative Routing Examples}{appendix.B}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Compact summary of qualitative routing examples (FAVC FV-RA, seed\nobreakspace  {}44, top-gap cases). For all six cases the ground-truth label is fake (manipulated video) and the audio is genuine, so the expected $P(\mathrm  {fake})$ is close to $1$. Two-way assigns near-zero in every case (audio shortcut); \textsc  {TriRoute}\ correctly assigns near-one. The score gap is $P_{\textsc  {TriRoute}}(\mathrm  {fake}) - P_{\text  {two-way}}(\mathrm  {fake})$. ``Synth.'' refers to the FAVC visual manipulation pipeline encoded in the clip filename (Wav2Lip-style for \emph  {wavtolip} cases; remaining cases use clip-id codes that resolve to the FAVC face-reenactment pipelines).}}{17}{table.12}\protected@file@percent }
\newlabel{tab:qualitative_summary}{{12}{17}{Compact summary of qualitative routing examples (FAVC FV-RA, seed~44, top-gap cases). For all six cases the ground-truth label is fake (manipulated video) and the audio is genuine, so the expected $P(\mathrm {fake})$ is close to $1$. Two-way assigns near-zero in every case (audio shortcut); \method \ correctly assigns near-one. The score gap is $P_{\method }(\mathrm {fake}) - P_{\text {two-way}}(\mathrm {fake})$. ``Synth.'' refers to the FAVC visual manipulation pipeline encoded in the clip filename (Wav2Lip-style for \emph {wavtolip} cases; remaining cases use clip-id codes that resolve to the FAVC face-reenactment pipelines)}{table.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Five additional FV-RA cases (highest score gap after the representative case in Figure\nobreakspace  {}\ref {fig:qualitative_main}). For each row, \emph  {left:} three lip-region frames; \emph  {middle:} audio waveform; \emph  {right:} model fake-probabilities. In every case the two-way baseline assigns $P(\mathrm  {fake}) \approx 0.01$ (audio-shortcut failure) and \textsc  {TriRoute}\ assigns $P(\mathrm  {fake}) \gtrsim 0.99$.}}{18}{figure.9}\protected@file@percent }
\newlabel{fig:qualitative_appendix}{{9}{18}{Five additional FV-RA cases (highest score gap after the representative case in Figure~\ref {fig:qualitative_main}). For each row, \emph {left:} three lip-region frames; \emph {middle:} audio waveform; \emph {right:} model fake-probabilities. In every case the two-way baseline assigns $P(\mathrm {fake}) \approx 0.01$ (audio-shortcut failure) and \method \ assigns $P(\mathrm {fake}) \gtrsim 0.99$}{figure.9}{}}
