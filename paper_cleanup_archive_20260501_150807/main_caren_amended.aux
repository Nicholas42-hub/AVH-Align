\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Subspace probe analysis. Linear probes are trained on each subspace and evaluated for cross-domain FV-RA AUC and domain-classification AUC. The visual-unique factor $u_v$ in \textsc  {TriRoute}\ achieves the strongest cross-domain probe AUC despite having only $256$ dimensions, while its domain probe is comparatively lower than the two-way fused representation.}}{13}{table.6}\protected@file@percent }
\newlabel{tab:subspace_probe}{{6}{13}{Subspace probe analysis. Linear probes are trained on each subspace and evaluated for cross-domain FV-RA AUC and domain-classification AUC. The visual-unique factor $u_v$ in \method \ achieves the strongest cross-domain probe AUC despite having only $256$ dimensions, while its domain probe is comparatively lower than the two-way fused representation}{table.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Subspace probe AUCs for OOD FV-RA prediction (teal) and source/target domain prediction (orange) across the six subspaces in Table\nobreakspace  {}\ref {tab:subspace_probe}. The visual-unique factor $u_v$ in \textsc  {TriRoute}\ achieves the strongest cross-domain probe AUC ($0.924$) despite its lower dimensionality ($256$d), while the domain probe stays high ($0.976$). High domain AUC across all subspaces indicates that the gain reflects routing rather than full domain invariance.}}{13}{figure.7}\protected@file@percent }
\newlabel{fig:subspace_probe}{{7}{13}{Subspace probe AUCs for OOD FV-RA prediction (teal) and source/target domain prediction (orange) across the six subspaces in Table~\ref {tab:subspace_probe}. The visual-unique factor $u_v$ in \method \ achieves the strongest cross-domain probe AUC ($0.924$) despite its lower dimensionality ($256$d), while the domain probe stays high ($0.976$). High domain AUC across all subspaces indicates that the gain reflects routing rather than full domain invariance}{figure.7}{}}
