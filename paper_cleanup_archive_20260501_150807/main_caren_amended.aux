\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces t-SNE projections of \textsc  {TriRoute}'s residual and manipulation factors on held-out clips from AV-Deepfake1M, FakeAVCeleb, and AVLips. \emph  {Left:} the residual factor (``domain factor'') cleanly separates source and target datasets, confirming that domain-correlated nuisance is concentrated in the branch that is structurally excluded from the prediction head. \emph  {Right:} the manipulation factor separates real from fake regardless of dataset, indicating that the prediction-relevant subspace generalizes across domains.}}{14}{figure.8}\protected@file@percent }
\newlabel{fig:tsne}{{8}{14}{t-SNE projections of \method 's residual and manipulation factors on held-out clips from AV-Deepfake1M, FakeAVCeleb, and AVLips. \emph {Left:} the residual factor (``domain factor'') cleanly separates source and target datasets, confirming that domain-correlated nuisance is concentrated in the branch that is structurally excluded from the prediction head. \emph {Right:} the manipulation factor separates real from fake regardless of dataset, indicating that the prediction-relevant subspace generalizes across domains}{figure.8}{}}
