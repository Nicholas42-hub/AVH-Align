\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Head-ablation routing dependence on the visual branches, summarising Table\nobreakspace  {}\ref {tab:ablation}. Each bar is the magnitude of the FV-RA AUC drop when visual branches are masked. Only the factorized \textsc  {TriRoute}\ model is meaningfully sensitive to removing visual components: the drop is roughly an order of magnitude larger than the two-way baseline ($-0.345$ vs.\ $-0.034$).}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:head_ablation_delta}{{3}{10}{Head-ablation routing dependence on the visual branches, summarising Table~\ref {tab:ablation}. Each bar is the magnitude of the FV-RA AUC drop when visual branches are masked. Only the factorized \method \ model is meaningfully sensitive to removing visual components: the drop is roughly an order of magnitude larger than the two-way baseline ($-0.345$ vs.\ $-0.034$)}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Representative FV-RA case where the two-way baseline misclassifies (follows the audio shortcut) and \textsc  {TriRoute}\ corrects (routes through the visual stream). \emph  {Left:} three lip-region frames sampled across the clip, showing the manipulated visual stream. \emph  {Middle:} the audio waveform; this is genuine RealAudio, which a non-factorized detector reads as evidence of authenticity. \emph  {Right:} model fake-probabilities --- the two-way baseline assigns $P(\mathrm  {fake}) \approx 0.01$, while \textsc  {TriRoute}\ assigns $P(\mathrm  {fake}) \approx 1.00$. Five additional cases in Figure\nobreakspace  {}\ref {fig:qualitative_appendix}.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:qualitative_main}{{4}{10}{Representative FV-RA case where the two-way baseline misclassifies (follows the audio shortcut) and \method \ corrects (routes through the visual stream). \emph {Left:} three lip-region frames sampled across the clip, showing the manipulated visual stream. \emph {Middle:} the audio waveform; this is genuine RealAudio, which a non-factorized detector reads as evidence of authenticity. \emph {Right:} model fake-probabilities --- the two-way baseline assigns $P(\mathrm {fake}) \approx 0.01$, while \method \ assigns $P(\mathrm {fake}) \approx 1.00$. Five additional cases in Figure~\ref {fig:qualitative_appendix}}{figure.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Progressive masking sweep (mechanism-level evidence).}{10}{section*.13}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces FV-RA AUC under full input masking on the FakeAVCeleb FV-RA category. Each row reports the mean over three independent seeds. $\Delta $ = masked AUC $-$ baseline AUC. A positive $\Delta _{\mathrm  {audio}}$ indicates that removing the audio signal \emph  {helps} FV-RA detection, i.e., the model is actively exploiting the visual channel and suppressing misleading real-audio signal. Baseline values should be interpreted within this intervention protocol; the relative ordering matches the main table.}}{11}{table.4}\protected@file@percent }
\newlabel{tab:perturbation}{{4}{11}{FV-RA AUC under full input masking on the FakeAVCeleb FV-RA category. Each row reports the mean over three independent seeds. $\Delta $ = masked AUC $-$ baseline AUC. A positive $\Delta _{\mathrm {audio}}$ indicates that removing the audio signal \emph {helps} FV-RA detection, i.e., the model is actively exploiting the visual channel and suppressing misleading real-audio signal. Baseline values should be interpreted within this intervention protocol; the relative ordering matches the main table}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Progressive input masking on the FAVC FV-RA category. \emph  {Left:} masking the visual channel monotonically lowers FV-RA AUC, with the steepest drop for \textsc  {TriRoute}. \emph  {Right:} masking the audio channel monotonically raises FV-RA AUC, indicating the real-audio stream was acting as a distractor that the visual-routed detector benefits from suppressing. The two-way baseline is nearly flat under visual masking, consistent with weak visual routing.}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:masking_sweep}{{5}{11}{Progressive input masking on the FAVC FV-RA category. \emph {Left:} masking the visual channel monotonically lowers FV-RA AUC, with the steepest drop for \method . \emph {Right:} masking the audio channel monotonically raises FV-RA AUC, indicating the real-audio stream was acting as a distractor that the visual-routed detector benefits from suppressing. The two-way baseline is nearly flat under visual masking, consistent with weak visual routing}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Subspace Probe Analysis}{11}{subsection.6.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Per-frame routing map for two FAVC clips classified by \textsc  {TriRoute}. We plot the time-varying feature norm of the visual-unique factor $\|u_v^t\|$ (solid blue) and the residual factor $\|r_v^t\|$ (dashed orange). \emph  {Top:} a correctly classified fake (FV-RA) clip --- $\|u_v^t\|$ has sharp peaks aligned with manipulation events, with the residual remaining background-level. \emph  {Bottom:} a correctly classified real clip --- $\|u_v^t\|$ stays low while the residual carries the bulk of the activation. The detector reads only $u_v$ (and $s_v$) at the prediction head, so the asymmetry in $\|u_v^t\|$ between the two clips is what drives the score.}}{12}{figure.6}\protected@file@percent }
\newlabel{fig:routing_map}{{6}{12}{Per-frame routing map for two FAVC clips classified by \method . We plot the time-varying feature norm of the visual-unique factor $\|u_v^t\|$ (solid blue) and the residual factor $\|r_v^t\|$ (dashed orange). \emph {Top:} a correctly classified fake (FV-RA) clip --- $\|u_v^t\|$ has sharp peaks aligned with manipulation events, with the residual remaining background-level. \emph {Bottom:} a correctly classified real clip --- $\|u_v^t\|$ stays low while the residual carries the bulk of the activation. The detector reads only $u_v$ (and $s_v$) at the prediction head, so the asymmetry in $\|u_v^t\|$ between the two clips is what drives the score}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Progressive input masking on FAVC FV-RA AUC. Top block: visual masking ($\Delta < 0$ indicates visual routing). Bottom block: audio masking ($\Delta > 0$ indicates audio was a distractor). Numbers correspond to Figure\nobreakspace  {}\ref {fig:masking_sweep}.}}{12}{table.5}\protected@file@percent }
\newlabel{tab:masking_sweep}{{5}{12}{Progressive input masking on FAVC FV-RA AUC. Top block: visual masking ($\Delta < 0$ indicates visual routing). Bottom block: audio masking ($\Delta > 0$ indicates audio was a distractor). Numbers correspond to Figure~\ref {fig:masking_sweep}}{table.5}{}}
