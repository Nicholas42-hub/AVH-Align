\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Training dynamics for \textsc  {TriRoute}\ (representative seed). As domain push-pull suppresses shortcuts in $Z_{\mathrm  {task}}$ (purple dash-dot, right axis), FV-RA AUC rises (red, left axis). The residual branch $Z_{\mathrm  {res}}$ absorbs the expelled domain information (green dotted, right axis). The two-way baseline FV-RA stays near chance (blue dashed), isolating the factorization as the enabling condition.}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:training_dynamics}{{5}{10}{Training dynamics for \method \ (representative seed). As domain push-pull suppresses shortcuts in $Z_{\mathrm {task}}$ (purple dash-dot, right axis), FV-RA AUC rises (red, left axis). The residual branch $Z_{\mathrm {res}}$ absorbs the expelled domain information (green dotted, right axis). The two-way baseline FV-RA stays near chance (blue dashed), isolating the factorization as the enabling condition}{figure.5}{}}
